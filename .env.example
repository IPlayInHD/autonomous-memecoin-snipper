# Copy to .env (gitignored). NEVER commit the real file.

# --- RPC (Helius free tier works; see README) ---
SNIPER_RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SNIPER_RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Enhanced-transactions API (deployer history). Optional but required for the deployer filter.
SNIPER_HELIUS_API_KEY=YOUR_KEY

# --- Wallet (only needed for shadow/live; paper mode needs no key at all) ---
# Preferred: encrypted keystore created with `python -m sniper.keystore create`.
# The passphrase can be supplied here or typed interactively at startup.
#SNIPER_KEYSTORE_PATH=keystore.json
#SNIPER_KEYSTORE_PASSPHRASE=

# Discouraged fallback (plaintext base58 private key of the BURNER wallet).
# Never a seed phrase. Never your main wallet.
#SNIPER_PRIVATE_KEY=

# --- Live-mode arming (second factor; config flag alone is not enough) ---
# Must be set to exactly this sentence for live mode to arm:
#SNIPER_LIVE_ACK=I_UNDERSTAND_THIS_WILL_PROBABLY_LOSE_MONEY
